# 复制成 .env 后按需修改：cp .env.docker.example .env
# 注意：这里的变量只给 docker-compose 用，跟程序自己的 /app/www/.env 是两回事
#      （程序 .env 由 /install 安装向导生成）。

# 对外访问端口
APP_PORT="8080"

# 时区
TZ="Asia/Shanghai"

# 数据库镜像：默认 MariaDB（amd64 + arm64 都有），要 MySQL 就改成 mysql:5.7 / mysql:8.0
DB_IMAGE="mariadb:10.11"

# MySQL 账号（安装向导里填同样的值）
DB_DATABASE="toolbox"
DB_USERNAME="toolbox"
DB_PASSWORD="请改成强密码"
DB_ROOT_PASSWORD="请改成强密码"
